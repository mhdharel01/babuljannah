# ===================================================
# KONFIGURASI SISTEM PSB PONDOK PESANTREN BABUL JANNAH
# ===================================================

# Lingkungan Aplikasi: 'local' (Localhost / XAMPP) atau 'production' (Hosting Live)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/babul%20jannah

# Database Localhost (XAMPP)
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=babul_jannah
DB_USER_LOCAL=root
DB_PASS_LOCAL=

# Database Server Hosting (Hostinger)
DB_HOST_PROD=localhost
DB_NAME_PROD=u168859970_Babul_jannah
DB_USER_PROD=u168859970_babuljannah
DB_PASS_PROD=password_anda

# Cloud Storage (Supabase)
SUPABASE_STORAGE_ENABLED=true
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your_supabase_secret_key
SUPABASE_BUCKET=babuljannah

# Pengaturan Notifikasi Email (SMTP)
MAIL_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@domain.com
SMTP_PASS=password_email
MAIL_FROM=info@domain.com
MAIL_FROM_NAME="Panitia PSB Babul Jannah"

# Notifikasi Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_ID=your_telegram_group_id

# API Integrasi Eksternal
API_SECRET_KEY=generate_random_secret_key_here
